{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "find",
  "description": "The blocks and nets of the packed design whose name matches a pattern, answer of 'find'. Version 1.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "stage",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "find"
    },
    "stage": {
      "const": "PACKED"
    },
    "data": {
      "type": "object",
      "required": [
        "pattern",
        "kind",
        "blocks",
        "nets"
      ],
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "block",
            "net",
            null
          ]
        },
        "blocks": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "total",
            "matched",
            "returned",
            "truncated",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "matched": {
              "type": "integer",
              "minimum": 0
            },
            "returned": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type",
                  "placed",
                  "x",
                  "y",
                  "sub_tile",
                  "layer"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "placed": {
                    "type": "boolean"
                  },
                  "x": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "y": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "sub_tile": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "layer": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "nets": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "total",
            "matched",
            "returned",
            "truncated",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "matched": {
              "type": "integer",
              "minimum": 0
            },
            "returned": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "fanout",
                  "ignored"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "fanout": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "ignored": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
