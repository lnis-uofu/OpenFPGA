{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "app_options",
  "description": "The application options, answer of 'report_app_option --json'. Version 1.",
  "type": "object",
  "required": ["schema_version", "kind", "stage", "data"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "app_options"},
    "stage": {"type": "null"},
    "data": {
      "type": "object",
      "required": ["options"],
      "additionalProperties": false,
      "properties": {
        "options": {
          "type": "array",
          "items": {"$ref": "#/$defs/option"}
        }
      }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "required": ["name", "type", "value", "default", "is_default", "help", "choices", "stage"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z_0-9]+\\.[A-Za-z_0-9]+$"},
        "type": {"enum": ["string", "int", "float", "bool", "selection"]},
        "value": {"$ref": "#/$defs/value"},
        "default": {"$ref": "#/$defs/value"},
        "is_default": {"type": "boolean"},
        "help": {"type": "string"},
        "choices": {"type": "array", "items": {"type": "string"}},
        "stage": {"enum": ["DEVICE", "PACKED", "PLACED", "ROUTED", "ANALYZED", "REPACKED", "BITSTREAM"]}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "int"}}}, "then": {"properties": {"value": {"type": "integer"}, "default": {"type": "integer"}}}},
        {"if": {"properties": {"type": {"const": "float"}}}, "then": {"properties": {"value": {"type": ["number", "null"]}, "default": {"type": ["number", "null"]}}}},
        {"if": {"properties": {"type": {"const": "bool"}}}, "then": {"properties": {"value": {"type": "boolean"}, "default": {"type": "boolean"}}}},
        {"if": {"properties": {"type": {"enum": ["string", "selection"]}}}, "then": {"properties": {"value": {"type": "string"}, "default": {"type": "string"}}}},
        {"if": {"properties": {"type": {"const": "selection"}}}, "then": {"properties": {"choices": {"minItems": 1}}}}
      ]
    },
    "value": {"type": ["string", "integer", "number", "boolean", "null"]}
  }
}
